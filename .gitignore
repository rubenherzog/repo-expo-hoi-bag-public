# Local paper-build intermediates are reproducible and must not be published.
results/main/*.xlsx
# Scanner workbooks include record-level metadata and are supplied explicitly
# at runtime; only the public CSV feature dictionaries are versioned.
data/metadata/*.xlsx
# outputs/ is local-only, EXCEPT the delivered figures and source data.
# Git cannot re-include through an excluded directory, so unwind it level by level.
outputs/*
!outputs/figures/
outputs/figures/*
!outputs/figures/dedup/
!outputs/figures/dedup/**
logs/
paper_figures.tar.gz
REPRO_DATA_ROOT/
